<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Maintenance settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Maintenance Plan" id="maintenance_plan_setting_block">
                    <setting
                        id="maintenance_plan_date"
                        string="Base date for next maintenance"
                        help="Maintenance request date used to determine the next maintenance date when a maintenance plan is configured. Note that this configuration is not compatible with the configuration of planning horizons on maintenance plans: for maintenance plans with planning horizon set, the date will automatically be the requested date."
                    >
                        <field
                            name="maintenance_plan_base_date"
                            class="o_light_label"
                            widget="radio"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
