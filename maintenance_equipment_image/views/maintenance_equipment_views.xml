<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_equipment_view_form" model="ir.ui.view">
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field
                    name="image_1920"
                    widget="image"
                    class="oe_avatar"
                    options='{"preview_image": "image_128"}'
                />
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_kanban" model="ir.ui.view">
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban" />
        <field name="arch" type="xml">
            <!-- v17+ OWL kanban: cards use a <t t-name="card"> template and the
                 legacy kanban_image() helper is gone; render the image field
                 directly with the image widget. -->
            <xpath expr="//templates/t[@t-name='card']" position="inside">
                <aside>
                    <field
                        name="image_128"
                        widget="image"
                        options="{'img_class': 'object-fit-contain'}"
                    />
                </aside>
            </xpath>
        </field>
    </record>

</odoo>
